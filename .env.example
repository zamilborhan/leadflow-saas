# LeadFlow BD — local development environment template.
# Copy to `.env` and fill in values. `.env` is gitignored; never commit real secrets.
# Production must provide secrets via a secrets manager, not this file.

NODE_ENV=development
PORT=3000

# --- PostgreSQL (Docker service `postgres`) ---
# Defaults below are local-dev only and must match docker-compose.yml fallbacks.
POSTGRES_USER=leadflow
POSTGRES_DB=leadflow
POSTGRES_PORT=5432
# Set a strong password in your local `.env`. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=change-me-in-your-local-env
DATABASE_URL="postgresql://leadflow:change-me-in-your-local-env@localhost:5432/leadflow"
# Requires PostgreSQL >= 15 (compose pins postgres:16).

# --- Redis (Docker service `redis`) ---
REDIS_PORT=6379
REDIS_URL="redis://localhost:6379"

# --- Auth ---
NEXTAUTH_URL="http://localhost:3000"
# Public app URL used for email links + OAuth redirect URIs (defaults to NEXTAUTH_URL).
# APP_URL="http://localhost:3000"
# Generate a strong random value for your local `.env`, e.g. `openssl rand -base64 32`.
NEXTAUTH_SECRET="generate-a-strong-random-value-for-local-dev-only"

# --- User-auth social login (Google/Facebook sign-in, server-only) ---
# Register redirect URIs <APP_URL>/api/auth/oauth/google/callback and
# <APP_URL>/api/auth/oauth/facebook/callback in each provider console.
# Leave unset to hide that provider's button (route returns 503).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Facebook Login reuses META_APP_ID/META_APP_SECRET below unless overridden:
# FACEBOOK_CLIENT_ID=
# FACEBOOK_CLIENT_SECRET=

# --- Outbound email (verification + password reset, server-only) ---
# `log` prints mail to server logs (local dev default). `resend` sends via
# https://resend.com (needs RESEND_API_KEY).
MAIL_PROVIDER=log
MAIL_FROM="LeadFlow BD <no-reply@localhost>"
# RESEND_API_KEY=

# --- Meta Lead Ads OAuth (server-only — never NEXT_PUBLIC_ prefixed) ---
# Register redirect URI <NEXTAUTH_URL>/api/meta/callback in the Meta App Dashboard.
META_APP_ID=change-me-meta-app-id
META_APP_SECRET=change-me-meta-app-secret
# 32-byte token encryption key: 64 hex chars (generate: openssl rand -hex 32).
META_TOKEN_KEY=change-me-64-hex-chars-meta-token-key-00000000000000000000000000
# Shared secret Meta echoes during webhook verification handshake.
META_WEBHOOK_VERIFY_TOKEN=change-me-meta-webhook-verify-token

# --- SSLCommerz payments (server-only — never NEXT_PUBLIC_ prefixed) ---
# Sandbox credentials come from https://developer.sslcommerz.com/registration/;
# live credentials from https://signup.sslcommerz.com/register. Configure the
# IPN URL <NEXTAUTH_URL>/api/webhooks/sslcommerz/ipn in the merchant panel
# (Menu > My Store > IPN Settings).
SSLCOMMERZ_STORE_ID=change-me-sslcommerz-store-id
SSLCOMMERZ_STORE_SECRET=change-me-sslcommerz-store-password
# "true" targets the sandbox host; any other value targets live.
SSLCOMMERZ_SANDBOX=true

# --- Platform super-admin (server-only — never NEXT_PUBLIC_ prefixed) ---
# Comma-separated login emails allowed into /admin and /api/admin/*.
# Workspace roles never grant platform access. Leave empty to disable.
# SUPER_ADMIN_EMAILS=owner@example.com

# --- Deferred integrations (do NOT configure yet) ---
# WhatsApp, billing and AI are out of scope for the infra setup task.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
